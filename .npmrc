# Lifecycle scripts must run: the root `postinstall` applies patches/next+12.3.4.patch
# via patch-package, and the Next.js build depends on that patch being applied.
# Build scripts for transitive dependencies are gated separately, by
# `onlyBuiltDependencies` in pnpm-workspace.yaml.
ignore-scripts=false

# Force pnpm to ignore any user-level `global-pnpmfile` while it is running
# inside this repo.
#
# Several of us keep a personal `~/.pnpm/global_pnpmfile.cjs` that blocks git
# dependencies. That is good practice, but it makes `pnpm-lock.yaml`'s
# `pnpmfileChecksum` depend on a file that differs per machine, so a contributor
# who has one — or CI, which has none — gets ERR_PNPM_LOCKFILE_CONFIG_MISMATCH
# on `pnpm install --frozen-lockfile`.
#
# Emptying it here means every machine hashes exactly one pnpmfile: the
# committed `.pnpmfile.cjs`, which implements the same git-dependency block as a
# project guarantee that is reviewable in PRs and active in CI. Nobody loses
# protection by opting out of their own hook here.
global-pnpmfile=
